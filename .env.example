# Copy to .env (git-ignored) and fill in. Never commit real values.
FRAUD_JWKS_URI=https://your-identity-provider/.well-known/jwks.json
FRAUD_JWT_ISSUER=https://your-identity-provider/
# Optional; defaults to fraud-detection-service
# FRAUD_JWT_AUDIENCE=fraud-detection-service
# Base64 of at least 32 random bytes: openssl rand -base64 32
FRAUD_CARD_TOKEN_KEY=
