meta {
  name: Accumulated rejection (1 of 2) - first attempt at a threat-100 terminal
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/fraud/assessments
  body: json
  auth: bearer
}

headers {
  X-Request-Id: bruno-accumulate-0001
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "amount": 10.00,
    "currency": "EUR",
    "terminalId": "T-1002",
    "terminalThreatScore": 100,
    "cardNumber": "4111111111111111"
  }
}

assert {
  res.status: eq 200
  res.body.triggeredRules[0].code: eq AMOUNT_VS_THREAT_SCORE
  res.body.triggeredRules[0].weightedContribution: eq 40
}
