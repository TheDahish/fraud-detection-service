meta {
  name: Assess - card number failing Luhn returns 400
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/fraud/assessments
  body: json
  auth: bearer
}

headers {
  X-Request-Id: bruno-badcard-0001
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "amount": 25.00,
    "currency": "EUR",
    "terminalId": "T-1001",
    "terminalThreatScore": 0,
    "cardNumber": "4111111111111112"
  }
}

assert {
  res.status: eq 400
  res.body.title: eq Invalid card number
}
